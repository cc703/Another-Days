.calendar-header {
  align-items: center;
}

.calendar-today {
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #ebe6dd;
  color: #4a4a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(74, 74, 74, 0.06);
}

.calendar-panel__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.calendar-panel__nav view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #f7f5f0;
  color: #82a888;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.calendar-panel__nav text {
  color: #4a4a4a;
  font-size: 28rpx;
  font-weight: 900;
}

.calendar-week,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-week {
  margin-bottom: 18rpx;
}

.calendar-week text {
  text-align: center;
  color: #8c8c8c;
  font-size: 20rpx;
  font-weight: 800;
}

.calendar-grid {
  row-gap: 18rpx;
}

.calendar-cell {
  min-height: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
}

.calendar-cell.is-future {
  opacity: 0.45;
}

.calendar-cell text {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #4a4a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.calendar-cell.is-today text,
.calendar-cell.is-selected text {
  background: #82a888;
  color: #ffffff;
  font-weight: 900;
  box-shadow: 0 8rpx 22rpx rgba(130, 168, 136, 0.24);
}

.calendar-cell__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #82a888;
}

.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin: 28rpx 0;
  color: #8c8c8c;
  font-size: 21rpx;
}

.calendar-legend view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.calendar-legend__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #82a888;
}

.calendar-legend__today {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #82a888;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
}

.calendar-action {
  margin-top: 0;
}

.calendar-action__pill {
  min-height: 80rpx;
  border-radius: 28rpx;
  background: #f7f5f0;
  color: #8c8c8c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.calendar-detail {
  margin-top: 24rpx;
}

.calendar-detail__stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin: 24rpx 0;
}

.calendar-detail__stats view {
  min-height: 116rpx;
  border-radius: 24rpx;
  background: #f7f5f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.calendar-detail__stats text:first-child {
  color: #4a4a4a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.calendar-detail__stats text:last-child,
.calendar-detail__note,
.calendar-empty {
  color: #8c8c8c;
  font-size: 21rpx;
}

.calendar-detail__note {
  margin-bottom: 18rpx;
  line-height: 1.5;
}

.calendar-section {
  padding-top: 24rpx;
  border-top: 2rpx solid #f7f5f0;
}

.calendar-section + .calendar-section {
  margin-top: 24rpx;
}

.calendar-section__title {
  display: block;
  margin-bottom: 16rpx;
  color: #4a4a4a;
  font-size: 24rpx;
  font-weight: 900;
}

.calendar-task {
  min-height: 64rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #ebe6dd;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  color: #4a4a4a;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 23rpx;
}

.calendar-task text:first-child {
  flex: 1;
  min-width: 0;
}

.calendar-task text:last-child {
  color: #82a888;
  font-weight: 900;
}

.calendar-diary {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f7f5f0;
}

.calendar-diary__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #82a888;
  font-size: 20rpx;
  font-weight: 900;
}

.calendar-diary__content {
  display: block;
  margin-top: 8rpx;
  color: #4a4a4a;
  font-size: 24rpx;
  line-height: 1.55;
}

.calendar-diary__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.calendar-diary__tags text {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef5ef;
  color: #82a888;
  display: flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 800;
}

.calendar-diary-modal {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(74, 74, 74, 0.28);
  display: flex;
  align-items: flex-end;
}

.calendar-diary-modal__panel {
  width: 100%;
  max-height: 78vh;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  padding: 34rpx 30rpx calc(38rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: auto;
}

.calendar-diary-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4a4a4a;
  font-size: 26rpx;
  font-weight: 900;
}

.calendar-diary-modal__header view {
  color: #8c8c8c;
  font-size: 46rpx;
  line-height: 1;
}

.calendar-diary-modal__mood {
  display: inline-flex;
  margin-top: 18rpx;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f7f5f0;
  color: #82a888;
  align-items: center;
  font-size: 22rpx;
  font-weight: 900;
}

.calendar-diary-modal__content {
  display: block;
  margin-top: 22rpx;
  color: #4a4a4a;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.calendar-diary-modal__images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.calendar-diary-modal__images image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 22rpx;
}
