.mascot {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.mascot--sm {
  width: 92rpx;
  height: 92rpx;
}

.mascot--md {
  width: 148rpx;
  height: 148rpx;
}

.mascot--lg {
  width: 214rpx;
  height: 214rpx;
}

.mascot--xl {
  width: 280rpx;
  height: 280rpx;
}

.mascot__paper {
  position: absolute;
  inset: 10rpx;
  border: 3rpx solid rgba(235, 226, 210, 0.5);
  background:
    linear-gradient(180deg, rgba(237, 228, 212, 0.92) 0%, rgba(204, 194, 178, 0.92) 100%);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.18);
  transform: rotate(-5deg);
}

.mascot__paper-tape {
  position: absolute;
  top: -10rpx;
  width: 28rpx;
  height: 18rpx;
  background: rgba(255, 244, 218, 0.78);
  border: 2rpx solid rgba(17, 17, 17, 0.12);
}

.mascot__paper-tape--left {
  left: 22rpx;
  transform: rotate(-16deg);
}

.mascot__paper-tape--right {
  right: 22rpx;
  transform: rotate(14deg);
}

.mascot__shadow {
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: 6%;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.24);
  filter: blur(6rpx);
}

.mascot__body {
  position: relative;
  z-index: 2;
  width: 72%;
  height: 76%;
}

.mascot__hood,
.mascot__head {
  position: absolute;
  inset: 0;
  background: #0f0f10;
}

.mascot__hood {
  border-radius: 42% 48% 36% 38% / 30% 34% 46% 50%;
  box-shadow:
    inset -16rpx -12rpx 0 rgba(255, 255, 255, 0.02),
    inset 16rpx 12rpx 0 rgba(0, 0, 0, 0.24),
    0 8rpx 18rpx rgba(0, 0, 0, 0.22);
  transform: rotate(-6deg);
}

.mascot__head {
  inset: 16% 14% 18%;
  border-radius: 44% 48% 38% 42% / 36% 38% 44% 48%;
  background:
    radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.08), transparent 18%),
    radial-gradient(circle at 70% 18%, rgba(255, 255, 255, 0.05), transparent 12%),
    #111111;
}

.mascot__arm,
.mascot__leg {
  position: absolute;
  background: #121212;
  border-radius: 999rpx;
}

.mascot__arm {
  top: 58%;
  width: 22%;
  height: 16%;
}

.mascot__arm--left {
  left: 2%;
  transform: rotate(26deg);
}

.mascot__arm--right {
  right: 0;
  transform: rotate(-24deg);
}

.mascot__leg {
  bottom: 2%;
  width: 24%;
  height: 14%;
}

.mascot__leg--left {
  left: 18%;
  transform: rotate(-16deg);
}

.mascot__leg--right {
  right: 16%;
  transform: rotate(16deg);
}

.mascot__eye {
  position: absolute;
  top: 34%;
  width: 20%;
  height: 20%;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 0 2rpx rgba(17, 17, 17, 0.16);
}

.mascot__eye--left {
  left: 22%;
}

.mascot__eye--right {
  right: 20%;
}

.mascot__pupil {
  position: absolute;
  left: 42%;
  top: 42%;
  width: 32%;
  height: 32%;
  border-radius: 50%;
  background: #111111;
}

.mascot__mouth {
  position: absolute;
  left: 50%;
  bottom: 24%;
  width: 18%;
  height: 6%;
  margin-left: -9%;
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 0 0 999rpx 999rpx;
}

.mascot__spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.mascot__spark--a {
  left: 18%;
  top: 18%;
}

.mascot__spark--b {
  right: 14%;
  top: 26%;
}

.mascot__tag {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  padding: 6rpx 10rpx;
  border: 3rpx solid #111111;
  background: #ffb400;
  color: #111111;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 900;
  transform: rotate(8deg);
  z-index: 3;
}

.mascot--tired .mascot__body {
  transform: rotate(4deg);
}

.mascot--tired .mascot__mouth {
  width: 14%;
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mascot--tired .mascot__eye {
  height: 18%;
}

.mascot--tired .mascot__pupil {
  top: 52%;
}

.mascot--focus .mascot__pupil {
  left: 38%;
  top: 52%;
}

.mascot--focus .mascot__mouth {
  width: 12%;
}

.mascot--cheer .mascot__body {
  transform: rotate(-6deg);
}

.mascot--cheer .mascot__mouth {
  height: 8%;
  border-bottom-width: 5rpx;
  border-bottom-color: rgba(255, 255, 255, 0.18);
}

.mascot--cheer .mascot__spark {
  background: #ffd36b;
}

.mascot--glow .mascot__hood {
  box-shadow:
    inset -16rpx -12rpx 0 rgba(255, 255, 255, 0.04),
    inset 16rpx 12rpx 0 rgba(0, 0, 0, 0.3),
    0 0 24rpx rgba(255, 180, 0, 0.2);
}
