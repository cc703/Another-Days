.neo-card {
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(17, 17, 17, 0.24);
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.18);
}

.neo-card--padded {
  padding: 24rpx;
}

.neo-card__inner {
  position: relative;
  z-index: 2;
}

.neo-card__grain {
  position: absolute;
  inset: 0;
  opacity: 0.06;
  background-image:
    linear-gradient(transparent 0, transparent 8rpx, rgba(17, 17, 17, 0.2) 8rpx, transparent 10rpx),
    linear-gradient(90deg, rgba(17, 17, 17, 0.06) 1px, transparent 1px);
  background-size: 100% 18rpx, 18rpx 100%;
}

.neo-card--dotted .neo-card__grain {
  opacity: 0.1;
  background-image: radial-gradient(rgba(17, 17, 17, 0.35) 1px, transparent 0);
  background-size: 16rpx 16rpx;
}

.neo-card__tape {
  position: absolute;
  top: -6rpx;
  width: 30rpx;
  height: 18rpx;
  background: rgba(255, 247, 229, 0.72);
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  z-index: 3;
}

.neo-card__tape--left {
  left: 26rpx;
  transform: rotate(-16deg);
}

.neo-card__tape--right {
  right: 32rpx;
  transform: rotate(14deg);
}

.neo-card__pin {
  position: absolute;
  right: 18rpx;
  top: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(40, 40, 40, 0.72);
  box-shadow: 0 2rpx 2rpx rgba(0, 0, 0, 0.2);
  z-index: 3;
}

.neo-card--paper {
  background: linear-gradient(180deg, #ede8dc 0%, #dcd3c1 100%);
  color: #111111;
}

.neo-card--hot {
  background: linear-gradient(180deg, #ff6461 0%, #ca463d 100%);
  color: #fff6ea;
}

.neo-card--cool {
  background: linear-gradient(180deg, #efe7d9 0%, #d6ccbb 100%);
  color: #111111;
}

.neo-card--ink {
  background: linear-gradient(180deg, #1b1b1c 0%, #131313 100%);
  color: #ededed;
}

.neo-card--amber {
  background: linear-gradient(180deg, #ffbf1f 0%, #d69806 100%);
  color: #111111;
}

.neo-card--violet {
  background: linear-gradient(180deg, #efe7d9 0%, #d6ccbb 100%);
  color: #111111;
}

.neo-card--mint {
  background: linear-gradient(180deg, #efe7d9 0%, #d6ccbb 100%);
  color: #111111;
}
